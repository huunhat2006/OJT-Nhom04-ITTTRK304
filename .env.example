# ============================================================
# .env.example — BTON Environment Variables
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# NEVER commit the actual .env file to version control!
# ============================================================

# ── MySQL ─────────────────────────────────────────────────────
# Root password (used only by MySQL container internally)
MYSQL_ROOT_PASSWORD=change_me_root_password

# Application database name
MYSQL_DATABASE=bton_db

# Application DB user (least-privilege — NOT root)
MYSQL_USER=bton

# Application DB password
MYSQL_PASSWORD=change_me_db_password

# Host port MySQL is exposed on (default 3306)
MYSQL_PORT=3306

# ── Backend ───────────────────────────────────────────────────
# Host port the Spring Boot backend listens on (default 8080)
BACKEND_PORT=8080

# JWT signing secret — must be at least 256-bit (32 chars) random string
# Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secret_at_least_256_bits_long

# JWT access token expiry in milliseconds (default 86400000 = 24h)
JWT_EXPIRATION=86400000

# Comma-separated list of allowed CORS origins for the backend
# Use * to allow all origins (including budgivee.online and localhost)
CORS_ALLOWED_ORIGINS=*

# ── Frontend ──────────────────────────────────────────────────
# Host port Nginx / frontend listens on (default 80)
FRONTEND_PORT=80

# ── Google OAuth2 ─────────────────────────────────────────────
# Lấy từ https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ── Mail Service (Gmail SMTP) ─────────────────────────────────
# Dùng Gmail App Password (16 ký tự) từ https://myaccount.google.com/apppasswords
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_16_char_gmail_app_password
